# Server-only secrets for optional Cloud Pro.
# Never expose OPENAI_API_KEY through VITE_* variables or client-side code.
OPENAI_API_KEY=
CLOUD_PRO_ACCESS_TOKEN=
CLOUD_PRO_ALLOWED_ORIGINS=https://nikoju1977.github.io

# Optional pin/quality overrides.
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst-2026-09-08
OPENAI_IMAGE_QUALITY=xhigh

# Optional: build-time default endpoint for the GitHub Pages client.
# Example: https://your-secure-backend.vercel.app/api/cloud-pro
VITE_CLOUD_PRO_ENDPOINT=
